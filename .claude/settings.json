{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current)",
      "Bash(uv build)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff format --check .)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git mv*)",
      "Bash(git rm*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git tag*)",
      "Bash(python -c*)",
      "Bash(python3 -c*)",
      "Bash(node -e*)",
      "Bash(rm -rf*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.ssh/**)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*service-account*.json)",
      "Read(.env*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "**/.env*",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*service-account*.json",
        ".env*"
      ]
    }
  }
}
